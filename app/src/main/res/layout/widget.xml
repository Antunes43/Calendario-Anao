<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:paddingLeft="17dp" android:paddingRight="17dp" android:paddingTop="12dp" android:paddingBottom="12dp"
 android:background="@drawable/widget_nurtfahani_moldura_aprovada">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1.16" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_horizontal" android:paddingRight="4dp">
  <ImageView android:id="@+id/widgetMoon" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Fase lunar"/>
  <TextView android:id="@+id/widgetMoonLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:textSize="11sp" android:textStyle="bold" android:textColor="#F3E8D7"/>
  <TextView android:id="@+id/widgetMoonKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:textSize="10sp" android:textColor="#D8A35F"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="3dp"
   android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:id="@+id/widgetPhase0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/lua_nova"/>
   <ImageView android:id="@+id/widgetPhase1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/lua_crescente"/>
   <ImageView android:id="@+id/widgetPhase2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/quarto_crescente"/>
   <ImageView android:id="@+id/widgetPhase3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/gibosa_crescente"/>
   <ImageView android:id="@+id/widgetPhase4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/lua_cheia"/>
   <ImageView android:id="@+id/widgetPhase5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/gibosa_minguante"/>
   <ImageView android:id="@+id/widgetPhase6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/quarto_minguante"/>
   <ImageView android:id="@+id/widgetPhase7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:scaleType="fitCenter" android:src="@drawable/lua_minguante"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1.14" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="3dp">
  <TextView android:id="@+id/widgetDate" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:maxLines="2" android:textSize="17sp" android:textStyle="bold" android:textColor="#F5E7CA"/>
  <TextView android:id="@+id/widgetMonthMeaning" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:maxLines="2" android:textSize="11sp" android:textColor="#C49A59"/>
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp"
   android:layout_marginBottom="6dp" android:background="#886A42"/>
  <TextView android:id="@+id/widgetWeekKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:maxLines="1" android:textSize="15sp" android:textStyle="bold" android:textColor="#D8A35F"/>
  <TextView android:id="@+id/widgetWeekPt" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:textSize="12sp" android:textColor="#F3E8D7"/>
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text=""/>
  <TextView android:id="@+id/widgetGregorian" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:maxLines="2" android:textSize="10sp" android:textColor="#D0C2AE"/>
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_weight="0.80" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_horizontal" android:paddingLeft="4dp">
  <ImageView android:id="@+id/widgetSeasonIcon" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Estação anã"/>
  <TextView android:id="@+id/widgetSeasonPt" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" android:textColor="#D8A35F"/>
  <TextView android:id="@+id/widgetSeasonKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:textSize="10sp" android:textColor="#F3E8D7"/>
 </LinearLayout>
</LinearLayout>