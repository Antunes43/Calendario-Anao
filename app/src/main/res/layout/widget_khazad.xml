<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widgetFrame" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Moldura NURTFAHANI"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="22dp" android:paddingBottom="28dp">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center" android:translationX="-4dp" android:paddingLeft="2dp" android:paddingRight="2dp">
  <ImageView android:id="@+id/widgetMoon" android:layout_width="match_parent" android:layout_height="150dp" android:translationY="-13dp" android:scaleType="fitCenter" android:contentDescription="Fase lunar"/>
  <TextView android:id="@+id/widgetMoonLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:translationY="-18dp" android:layout_marginTop="0dp" android:textSize="15sp" android:textStyle="bold" android:textColor="#F3E8D7"/>
  <TextView android:id="@+id/widgetMoonKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:textSize="12sp" android:textColor="#D8A35F"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:translationY="-18dp" android:layout_marginTop="5dp"
   android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:id="@+id/widgetPhase0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/lua_nova"/>
   <ImageView android:id="@+id/widgetPhase1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/lua_crescente"/>
   <ImageView android:id="@+id/widgetPhase2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/quarto_crescente"/>
   <ImageView android:id="@+id/widgetPhase3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/gibosa_crescente"/>
   <ImageView android:id="@+id/widgetPhase4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/lua_cheia"/>
   <ImageView android:id="@+id/widgetPhase5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/gibosa_minguante"/>
   <ImageView android:id="@+id/widgetPhase6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/quarto_minguante"/>
   <ImageView android:id="@+id/widgetPhase7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/lua_minguante"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_horizontal" android:paddingLeft="3dp" android:paddingRight="3dp">
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text=""/>
  <TextView android:id="@+id/widgetDate" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:textSize="17sp" android:textStyle="bold" android:textColor="#F5E7CA"/>
  <TextView android:id="@+id/widgetMonthMeaning" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:textSize="14sp" android:textColor="#E4BC82"/>
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp"
   android:layout_marginBottom="8dp" android:background="#886A42"/>
  <TextView android:id="@+id/widgetWeekKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="1" android:textSize="17sp" android:textStyle="bold" android:textColor="#D8A35F"/>
  <TextView android:id="@+id/widgetWeekPt" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:textSize="15sp" android:textColor="#F3E8D7"/>
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text=""/>
  <TextView android:id="@+id/widgetGregorian" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="1" android:singleLine="true" android:translationY="-9dp" android:textSize="11sp" android:textColor="#F0E3D2"/>
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center" android:translationX="5dp" android:paddingLeft="2dp" android:paddingRight="2dp">
  <ImageView android:id="@+id/widgetSeasonIcon" android:layout_width="86dp" android:layout_height="86dp" android:translationY="-14dp" android:scaleType="fitCenter" android:contentDescription="Estação anã"/>
  <TextView android:id="@+id/widgetSeasonPt" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="1" android:translationY="-12dp" android:layout_marginTop="5dp" android:textSize="16sp" android:textStyle="bold" android:textColor="#D8A35F"/>
  <TextView android:id="@+id/widgetSeasonKh" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:maxLines="2" android:translationY="-12dp" android:textSize="14sp" android:textColor="#F3E8D7"/>
 </LinearLayout>
</LinearLayout>
</FrameLayout>