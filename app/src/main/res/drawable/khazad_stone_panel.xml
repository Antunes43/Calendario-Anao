<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item>
  <shape android:shape="rectangle">
   <gradient android:angle="90" android:startColor="#353536" android:centerColor="#222426" android:endColor="#151719"/>
   <stroke android:width="2dp" android:color="#B99252"/>
   <corners android:radius="5dp"/>
  </shape>
 </item>
 <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
  <shape android:shape="rectangle">
   <solid android:color="#00202020"/>
   <stroke android:width="1dp" android:color="#6F593B"/>
   <corners android:radius="2dp"/>
  </shape>
 </item>
 <item android:left="13dp" android:top="13dp" android:right="13dp" android:bottom="13dp">
  <shape android:shape="rectangle">
   <solid android:color="#00202020"/>
   <stroke android:width="1dp" android:color="#45423A"/>
  </shape>
 </item>
</layer-list>